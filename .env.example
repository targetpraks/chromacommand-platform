# ChromaCommand Platform — Local Environment

# MQTT Broker (Mosquitto, local)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=""
MQTT_PASSWORD=""

# tRPC API (internal)
NEXT_PUBLIC_API_URL=http://localhost:3001

# n8n firmware event webhook
N8N_WEBHOOK_URL=http://localhost:5678/webhook/firmware-event

# SMTP for alert email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@chromacommand.local

# Edge Device X.509 (placeholder for production mTLS)
EDGE_CA_CERT_PATH=/certs/ca.crt
EDGE_CLIENT_CERT_PATH=/certs/client.crt
EDGE_CLIENT_KEY_PATH=/certs/client.key
